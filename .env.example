# Copy to .env and use the pooled connection string from your Neon project.
# Server-only secret. Never commit a real URL or use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# --- Google OAuth -----------------------------------------------------------
# When GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and AUTH_SECRET are set, sign-in
# uses Google. AUTH_SECRET must be at least 32 characters. Only loopback
# development with both Google credentials absent can use the local mock.
# Production and incomplete configurations never fall back to a mock account.
#
# Create a "Web application" client in Google Auth Platform > Clients:
#   https://console.cloud.google.com/auth/clients?project=opendraft-workshop
# Add an Authorized redirect URI of <your-host>/api/auth/callback, for example
#   http://127.0.0.1:5173/api/auth/callback
#   https://your-app.vercel.app/api/auth/callback
# The URI here must exactly match the registered Google redirect URI and the
# hostname you use to visit the app (localhost and 127.0.0.1 are different).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# 32+ character random string used to sign HttpOnly session and OAuth cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# --- Email and password -----------------------------------------------------
# Production email/password registration is enabled only when both values are
# set. Passwords are stored as salted PBKDF2 hashes; Resend only receives the
# destination address and verification/reset message. Local development shows
# the one-time link in the UI when these values are omitted.
RESEND_API_KEY=
# Server-only random secret for /api/cron/work-updates. Vercel sends it as a bearer token.
CRON_SECRET=
AUTH_EMAIL_FROM=OpenDraft <hello@your-domain.example>
# Canonical public origin used in email links, without a trailing slash.
AUTH_APP_URL=https://your-app.vercel.app

# Public source repository link shown in the landing page, footer, and About.
# This is public configuration, not a credential.
SOURCE_REPOSITORY_URL=

# Comma-separated operator emails allowed into the admin dashboard.
ADMIN_EMAILS=

# Optional profile pictures: enable vision.googleapis.com in a billed project.
# Restrict this key to Cloud Vision API. Keep it server-only in Vercel too.
# Uploads remain disabled if screening is unavailable; initials still work.
GOOGLE_VISION_API_KEY=

# Optional Jev showcase assistance, only for explicitly consented works.
# Vercel uses this server-only key when set, otherwise its request OIDC token.
# Local development also accepts this key. Never expose it to the browser.
AI_GATEWAY_API_KEY=
